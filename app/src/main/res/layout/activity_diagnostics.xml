<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_black"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/panel_margin">

        <com.flex.cameradev.ui.views.LiquidGlassPanel
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/panel_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/diagnostics_title" />

                <TextView
                    android:id="@+id/diagnosticsBody"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="monospace"
                    android:textIsSelectable="true" />
            </LinearLayout>
        </com.flex.cameradev.ui.views.LiquidGlassPanel>

        <com.flex.cameradev.ui.views.LiquidGlassPanel
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="@dimen/panel_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/diagnostics_pending_title" />

                <TextView
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/diagnostics_pending_body" />
            </LinearLayout>
        </com.flex.cameradev.ui.views.LiquidGlassPanel>

        <TextView
            android:id="@+id/diagnosticsCopyButton"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:text="@string/diagnostics_copy" />

        <TextView
            android:id="@+id/diagnosticsCloseButton"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:text="@string/info_close" />
    </LinearLayout>
</ScrollView>
